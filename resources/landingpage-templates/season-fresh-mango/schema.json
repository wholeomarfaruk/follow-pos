{
    "seo": {
        "label": "SEO Settings",
        "order": 1,
        "collapsible": true,
        "fields": {
            "meta_title": {
                "type": "text",
                "label": "Meta Title",
                "placeholder": "Season Fresh Mango — সরাসরি বাগান থেকে",
                "rules": "required|string|max:70",
                "key": "seo.meta_title"
            },
            "meta_description": {
                "type": "textarea",
                "label": "Meta Description",
                "placeholder": "রাজশাহীর সেরা গাছপাকা আম।",
                "rules": "required|string|max:160",
                "key": "seo.meta_description"
            },
            "meta_image": {
                "type": "text",
                "label": "Meta Image URL",
                "rules": "nullable|string",
                "key": "seo.meta_image"
            },
            "favicon_url": {
                "type": "text",
                "label": "Favicon URL (.ico / .png)",
                "rules": "nullable|string",
                "key": "seo.favicon_url"
            }
        }
    },
    "nav": {
        "label": "Navigation Menus",
        "order": 2,
        "fields": [
            { "type": "text", "label": "Menu 1 — Label", "rules": "nullable|string", "key": "nav.menus.0.label" },
            { "type": "text", "label": "Menu 1 — Link (href)", "rules": "nullable|string", "key": "nav.menus.0.href" },
            { "type": "text", "label": "Menu 2 — Label", "rules": "nullable|string", "key": "nav.menus.1.label" },
            { "type": "text", "label": "Menu 2 — Link (href)", "rules": "nullable|string", "key": "nav.menus.1.href" },
            { "type": "text", "label": "Menu 3 — Label", "rules": "nullable|string", "key": "nav.menus.2.label" },
            { "type": "text", "label": "Menu 3 — Link (href)", "rules": "nullable|string", "key": "nav.menus.2.href" },
            { "type": "text", "label": "Menu 4 — Label", "rules": "nullable|string", "key": "nav.menus.3.label" },
            { "type": "text", "label": "Menu 4 — Link (href)", "rules": "nullable|string", "key": "nav.menus.3.href" },
            { "type": "text", "label": "Menu 5 — Label", "rules": "nullable|string", "key": "nav.menus.4.label" },
            { "type": "text", "label": "Menu 5 — Link (href)", "rules": "nullable|string", "key": "nav.menus.4.href" },
            { "type": "text", "label": "Menu 6 — Label", "rules": "nullable|string", "key": "nav.menus.5.label" },
            { "type": "text", "label": "Menu 6 — Link (href)", "rules": "nullable|string", "key": "nav.menus.5.href" },
            { "type": "text", "label": "Menu 7 — Label", "rules": "nullable|string", "key": "nav.menus.6.label" },
            { "type": "text", "label": "Menu 7 — Link (href)", "rules": "nullable|string", "key": "nav.menus.6.href" },
            { "type": "text", "label": "Menu 8 — Label", "rules": "nullable|string", "key": "nav.menus.7.label" },
            { "type": "text", "label": "Menu 8 — Link (href)", "rules": "nullable|string", "key": "nav.menus.7.href" }
        ]
    },
    "hero": {
        "label": "Hero Section",
        "order": 3,
        "collapsible": true,
        "fields": {
            "logo_url": {
                "type": "text",
                "label": "Logo Image URL",
                "rules": "nullable|string",
                "key": "hero.logo_url"
            },
            "bg_url": {
                "type": "text",
                "label": "Hero Background Image URL",
                "rules": "nullable|string",
                "key": "hero.bg_url"
            },
            "badge": {
                "type": "text",
                "label": "Badge Text",
                "rules": "required|string|max:80",
                "key": "hero.badge"
            },
            "type_line1_raw": {
                "type": "text",
                "label": "Typewriter Line 1 (plain text)",
                "rules": "required|string|max:80",
                "key": "hero.type_line1_raw"
            },
            "type_line1_html": {
                "type": "text",
                "label": "Typewriter Line 1 (HTML — after typing finishes)",
                "rules": "required|string",
                "key": "hero.type_line1_html"
            },
            "type_line2": {
                "type": "text",
                "label": "Typewriter Line 2",
                "rules": "required|string|max:80",
                "key": "hero.type_line2"
            },
            "subtitle": {
                "type": "textarea",
                "label": "Hero Subtitle (HTML allowed for <br>)",
                "rules": "required|string",
                "key": "hero.subtitle"
            },
            "cta_text": {
                "type": "text",
                "label": "CTA Button Text",
                "rules": "required|string|max:60",
                "key": "hero.cta_text"
            }
        }
    },
    "contact": {
        "label": "Contact & Payment",
        "order": 4,
        "fields": {
            "bkash_number": {
                "type": "text",
                "label": "bKash Number",
                "rules": "required|string|max:20",
                "key": "contact.bkash_number"
            },
            "phone": {
                "type": "text",
                "label": "Phone Number (for Call button)",
                "rules": "required|string|max:20",
                "key": "contact.phone"
            },
            "whatsapp_url": {
                "type": "text",
                "label": "WhatsApp URL (for floating button, e.g. https://wa.me/8801XXXXXXXXX)",
                "rules": "nullable|string",
                "key": "contact.whatsapp_url"
            }
        }
    },
